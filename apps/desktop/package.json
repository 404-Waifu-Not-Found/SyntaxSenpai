{
  "name": "syntax-senpai-desktop",
  "version": "0.0.1",
  "description": "SyntaxSenpai desktop app (Electron)",
  "author": "unoxyrich",
  "repository": {
    "type": "git",
    "url": "https://github.com/unoxyrich/SyntaxSenpai.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/build-native.mjs && electron-vite dev",
    "start": "electron dist/main/index.js",
    "build": "node scripts/build-native.mjs && electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --environment node",
    "test:evaluation": "vitest run --config vitest.evaluation.config.ts --reporter verbose",
    "lint": "eslint . --ext .ts,.vue",
    "postinstall": "electron-builder install-app-deps",
    "build:native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@phosphor-icons/vue": "^2.2.0",
    "@syntax-senpai/agent-tools": "workspace:*",
    "@syntax-senpai/ai-core": "workspace:*",
    "@syntax-senpai/game-engine": "workspace:*",
    "@syntax-senpai/logger": "workspace:*",
    "@syntax-senpai/storage": "workspace:*",
    "@syntax-senpai/ui": "workspace:*",
    "@syntax-senpai/ui-loading-screens": "workspace:*",
    "@syntax-senpai/ui-transitions": "workspace:*",
    "@syntax-senpai/waifu-core": "workspace:*",
    "@syntax-senpai/wechat-ilink": "workspace:*",
    "@syntax-senpai/ws-protocol": "workspace:*",
    "@vueuse/core": "^14.2.1",
    "diff": "^9.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "html-to-image": "^1.11.13",
    "keytar": "^7.9.0",
    "pinia": "^3.0.2",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "qrcode": "^1.5.3",
    "vue": "^3.5.13",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.0",
    "@unocss/reset": "^66.6.7",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.2",
    "unocss": "^66.6.7",
    "vite": "^7.3.3",
    "vue-tsc": "^3.2.6"
  },
  "build": {
    "productName": "SyntaxSenpai",
    "appId": "ai.syntaxsenpai",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "."
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "binaries": [
        "resources/native/syntax-computer"
      ]
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "asar": false,
    "publish": []
  }
}
