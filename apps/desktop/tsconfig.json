{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@syntax-senpai/ai-core": ["../../packages/ai-core/src"],
      "@syntax-senpai/ai-core/*": ["../../packages/ai-core/src/*"],
      "@syntax-senpai/agent-tools": ["../../packages/agent-tools/src"],
      "@syntax-senpai/agent-tools/*": ["../../packages/agent-tools/src/*"],
      "@syntax-senpai/storage": ["../../packages/storage/src"],
      "@syntax-senpai/storage/*": ["../../packages/storage/src/*"],
      "@syntax-senpai/waifu-core": ["../../packages/waifu-core/src"],
      "@syntax-senpai/waifu-core/*": ["../../packages/waifu-core/src/*"],
      "@syntax-senpai/ws-protocol": ["../../packages/ws-protocol/src"],
      "@syntax-senpai/ws-protocol/*": ["../../packages/ws-protocol/src/*"],
      "@syntax-senpai/wechat-ilink": ["../../packages/wechat-ilink/src"],
      "@syntax-senpai/wechat-ilink/*": ["../../packages/wechat-ilink/src/*"]
    }
  },
  "include": ["src", "electron.vite.config.mjs", "../../packages/ws-protocol/src", "../../packages/wechat-ilink/src"],
  "exclude": ["node_modules", "dist"]
}
